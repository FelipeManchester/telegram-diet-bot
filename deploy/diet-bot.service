; Unit de USUÁRIO, não de sistema: o `claude` usa o login OAuth guardado no
; $HOME. Rodando como root o bot quebraria em toda extração.

[Unit]
Description=Bot de dieta via Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/felipe/Documents/Personal/telegram-diet-bot
ExecStart=/home/felipe/Documents/Personal/telegram-diet-bot/.venv/bin/python bot.py

Environment=PATH=/home/felipe/.local/bin:/usr/local/bin:/usr/bin:/bin

; Sempre de volta. RestartSec dá folga pra internet voltar depois do boot.
Restart=always
RestartSec=10


NoNewPrivileges=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

UMask=0077

[Install]
WantedBy=default.target

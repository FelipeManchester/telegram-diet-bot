# Telegram — token gerado no @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-bot-token-here

# Seu user_id numérico do Telegram (peça pro @userinfobot).
# Única conta autorizada a usar o bot — todo o resto é ignorado em silêncio.
TELEGRAM_USER_ID=000000000

# Supabase — Project Settings > API Keys
# Use a SECRET key (sb_secret_...), não a publishable.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Schema dedicado dentro do projeto Supabase que você já usa.
# Precisa estar em Settings > API > Data API > Exposed schemas.
SUPABASE_SCHEMA=dieta

# Opcionais (valores abaixo são os defaults)
# Fuso usado pelos resumos /hoje e /semana.
TIMEZONE=America/Sao_Paulo

WHISPER_MODEL=small
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT_SEC=120

# Caminho do CLI do Claude. Vazio = descoberto no PATH ou em ~/.local/bin.
# Só preencha se o binário estiver em outro lugar.
CLAUDE_BIN=
